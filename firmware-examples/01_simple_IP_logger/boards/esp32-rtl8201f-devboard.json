{
  "build": {
    "arduino":{
      "ldscript": "esp32_out.ld"
    },
    "core": "esp32",
    "extra_flags": "-DARDUINO_ESP32_DEV -DETH_PHY_ADDR=0 -DETH_PHY_MDC=23 -DETH_PHY_MDIO=18 -DETH_PHY_TYPE=ETH_PHY_RTL8201 -DETH_CLK_MODE=ETH_CLOCK_GPIO17_OUT",
    "f_cpu": "240000000L",
    "f_flash": "40000000L",
    "flash_mode": "dio",
    "mcu": "esp32",
    "variant": "esp32",
    "partitions": "default_8MB.csv"
  },
  "connectivity": [
    "wifi",
    "bluetooth",
    "ethernet",
    "can"
  ],
  "debug": {
    "openocd_board": "esp-wroom-32.cfg"
  },
  "frameworks": [
    "arduino",
    "espidf"
  ],
  "name": "ESP32 RTL8201F Dev Board",
  "upload": {
    "flash_size": "8MB",
    "maximum_ram_size": 327680,
    "maximum_size": 8388608,
    "require_upload_port": true,
    "speed": 921600
  },
  "url": "https://github.com/PhilipHiet/ESP32-RTL8201F-devboard",
  "vendor": "PhilipHiet"
}